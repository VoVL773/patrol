<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="default">

    <!-- ===== 基础三件套：缺一个仿真就起不来或不动 ===== -->
    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- ===== 传感器：相机和雷达靠它渲染，不加就一个数据都没有 ===== -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ===== IMU 要单独挂 ===== -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- ===== 光照 ===== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ===== 地面 ===== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== 户型：12m x 6m 封闭公寓 =====
         三个 L 形隔墙各带一个门洞：左上房（门在左下）、
         左下房（门在右下）、右下房（门在右侧）；右侧是大客厅。
         墙体厚 0.1m、高 1m；外墙厚 0.12m。 -->

    <!-- ===== 外墙 ===== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.12 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 0.12 1</size></box></geometry>
          <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.9 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.12 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 0.12 1</size></box></geometry>
          <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.9 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 6 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.12 6 1</size></box></geometry>
          <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.9 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 6 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.12 6 1</size></box></geometry>
          <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.9 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 左上房间：L 形隔墙，门洞在左侧（约 1m 宽） ===== -->
    <model name="room_ul_vertical">
      <static>true</static>
      <pose>-0.7 1.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 2.4 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 2.4 1</size></box></geometry>
          <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.9 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="room_ul_horizontal">
      <static>true</static>
      <pose>-2.85 0.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.3 0.1 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.3 0.1 1</size></box></geometry>
          <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.9 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 左下房间：L 形隔墙，门洞在下侧（约 0.8m 宽） ===== -->
    <model name="room_ll_horizontal">
      <static>true</static>
      <pose>-4.0 -1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.0 0.1 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.1 1</size></box></geometry>
          <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.9 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="room_ll_vertical">
      <static>true</static>
      <pose>-2.0 -1.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 1.2 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 1.2 1</size></box></geometry>
          <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.9 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 右下房间：L 形隔墙，门洞在右侧（约 0.8m 宽） ===== -->
    <model name="room_lr_vertical">
      <static>true</static>
      <pose>0.4 -2.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 1.8 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 1.8 1</size></box></geometry>
          <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.9 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="room_lr_horizontal">
      <static>true</static>
      <pose>2.8 -1.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.8 0.1 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.8 0.1 1</size></box></geometry>
          <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.9 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 客厅障碍：方块 + 圆柱（贴在左上房竖墙右侧） ===== -->
    <model name="box_obstacle">
      <static>true</static>
      <pose>-0.35 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.8 1</ambient><diffuse>0.4 0.4 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_obstacle">
      <static>true</static>
      <pose>-0.30 0.65 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.65 0.65 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 客厅右侧两根细杆 -->
    <model name="pole_1">
      <static>true</static>
      <pose>2.3 0.85 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.06</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.06</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pole_2">
      <static>true</static>
      <pose>2.75 0.85 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.06</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.06</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== 墙边小家具（6 个矮方块） ===== -->
    <model name="cab_ul_1"><static>true</static><pose>-2.9 2.75 0.2 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.35 0.35 0.4</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.35 0.35 0.4</size></box></geometry>
        <material><ambient>0.7 0.5 0.25 1</ambient><diffuse>0.8 0.6 0.3 1</diffuse></material></visual>
    </link></model>

    <model name="cab_ul_2"><static>true</static><pose>-2.1 2.75 0.2 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.35 0.35 0.4</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.35 0.35 0.4</size></box></geometry>
        <material><ambient>0.7 0.5 0.25 1</ambient><diffuse>0.8 0.6 0.3 1</diffuse></material></visual>
    </link></model>

    <model name="cab_ll_1"><static>true</static><pose>-5.1 -1.27 0.2 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.35 0.35 0.4</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.35 0.35 0.4</size></box></geometry>
        <material><ambient>0.7 0.5 0.25 1</ambient><diffuse>0.8 0.6 0.3 1</diffuse></material></visual>
    </link></model>

    <model name="cab_ll_2"><static>true</static><pose>-4.4 -1.27 0.2 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.35 0.35 0.4</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.35 0.35 0.4</size></box></geometry>
        <material><ambient>0.7 0.5 0.25 1</ambient><diffuse>0.8 0.6 0.3 1</diffuse></material></visual>
    </link></model>

    <model name="cab_lr_1"><static>true</static><pose>0.175 -1.6 0.2 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.35 0.35 0.4</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.35 0.35 0.4</size></box></geometry>
        <material><ambient>0.7 0.5 0.25 1</ambient><diffuse>0.8 0.6 0.3 1</diffuse></material></visual>
    </link></model>

    <model name="cab_lr_2"><static>true</static><pose>0.175 -2.3 0.2 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.35 0.35 0.4</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.35 0.35 0.4</size></box></geometry>
        <material><ambient>0.7 0.5 0.25 1</ambient><diffuse>0.8 0.6 0.3 1</diffuse></material></visual>
    </link></model>

  </world>
</sdf>
